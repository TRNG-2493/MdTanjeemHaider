classDiagram
    direction LR

    class TestResult {
        +VALID_STATUSES$
        +total_created$
        -_test_id
        -_status
        -_duration
        +message
        +test_id
        +status
        +duration
        +is_passed
        +is_valid_id(test_id)$
        +how_many()$
        +from_dict(data)$
        +from_csv_line(line)$
        +__str__()
        +__repr__()
    }

    class Suite {
        +name
        -_results
        +results
        +pass_rate
        +total_duration
        +from_rows(name, rows)$
        +add(result)
        +count()
        +counts_by_status()
        +failures()
        +slowest(n)
    }

    class Reporter {
        +suite
        +pad(text, width)$
        +format_percent(value)$
        +render()
        +line_count()
    }

    class TextReporter {
        +render()
    }

    class CsvReporter {
        +HEADER$
        +clean_cell(text)$
        +render()
    }

    TextReporter --|> Reporter
    CsvReporter --|> Reporter

    Suite "1" o-- "0..*" TestResult : has-many
    Reporter --> Suite : has-one